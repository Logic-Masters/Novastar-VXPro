-- The name that will initially display when dragged into a design
function GetPrettyName(props)
  return "Novastar VX Pro, v" .. PluginInfo.Version
end

-- Define User configurable Properties of the plugin
function GetProperties()
  local props = {}
  return props
end

-- Defines the Controls used within the plugin
function GetControls(props)
  local ctrls = {}
  table.insert(ctrls, {
    Name = "Model", 
    ControlType = "Text", 
    PinStyle = "None", 
    Count = 1, 
    UserPin = false
  })
  table.insert(ctrls, {
    Name = "Host", 
    ControlType = "Text", 
    PinStyle = "None", 
    Count = 1, 
    UserPin = false
  })
  table.insert(ctrls, {
    Name = "Port", 
    ControlType = "Text", 
    PinStyle = "None", 
    Count = 1, 
    UserPin = false
  })
  table.insert(ctrls, {
    Name = "Status", 
    ControlType = "Indicator", 
    IndicatorType = "Status",
    PinStyle = "None", 
    Count = 1, 
    UserPin = false
  })
  table.insert(ctrls, {
    Name = "Power",  
    ControlType = "Button", 
    ButtonType = "Toggle", 
    PinStyle = "Input", 
    Count = 1, 
    UserPin = true
  })
  table.insert(ctrls, {
    Name        = "Input", 
    ControlType = "Button", 
    ButtonType  = "Momentary", 
    PinStyle    = "Input", 
    Count       = 11, 
    UserPin     = true
  })
  table.insert(ctrls, {
    Name        = "PresetRecall", 
    ControlType = "Button", 
    ButtonType  = "Momentary", 
    PinStyle    = "Input", 
    Count       = 8, 
    UserPin     = true
  })
  table.insert(ctrls, {
    Name        = "PresetDelete", 
    ControlType = "Button", 
    ButtonType  = "Momentary", 
    PinStyle    = "Input", 
    Count       = 8, 
    UserPin     = true
  })
  table.insert(ctrls, {
    Name        = "TestPatterns", 
    ControlType = "Button", 
    ButtonType  = "Momentary", 
    PinStyle    = "Input", 
    Count       = 13, 
    UserPin     = true
  })
  table.insert(ctrls, {
    Name        = "BrightnessPresets", 
    ControlType = "Button", 
    ButtonType  = "Momentary", 
    PinStyle    = "Input", 
    Count       = 5, 
    UserPin     = true
  })
  table.insert(ctrls, {
    Name = "BrightnessDefault", 
    ControlType = "Knob", 
    ControlUnit = "Integer",
    Min = 0,                         -- minimum value for knob
    Max = 255,                       -- maximum value for knob
    DefaultValue = "100",
    PinStyle = "None", 
    Count = 1, 
    UserPin = false
  })
  table.insert(ctrls, {
    Name = "Brightness", 
    ControlType = "Knob", 
    ControlUnit = "Integer",
    Min = 0,                         -- minimum value for knob
    Max = 255,                       -- maximum value for knob
    PinStyle = "None", 
    Count = 1, 
    UserPin = false
  })
  return ctrls
end

