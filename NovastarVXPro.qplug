      {0x00,0x00,0xFE,0x00,0x00,0x00,0x00,0x00,0x01,0x00,0x04,0x01,0x51,0x13,0x01,0x00,0x05}, --Preset 6
      {0x00,0x00,0xFE,0x00,0x00,0x00,0x00,0x00,0x01,0x00,0x04,0x01,0x51,0x13,0x01,0x00,0x06}, --Preset 7
      {0x00,0x00,0xFE,0x00,0x00,0x00,0x00,0x00,0x01,0x00,0x04,0x01,0x51,0x13,0x01,0x00,0x07}, --Preset 8
    },
    TestPatterns = {
      {0x00,0x00,0xFE,0xFF,0x00,0x00,0x00,0x00,0x01,0x00,0x50,0x00,0x20,0x02,0x01,0x00,0x00}, --Disable Freeze/FTB
      {0x00,0x00,0xFE,0xFF,0x00,0x00,0x00,0x00,0x01,0x00,0x50,0x00,0x20,0x02,0x01,0x00,0x02}, --Freeze
      {0x00,0x00,0xFE,0xFF,0x00,0x00,0x00,0x00,0x01,0x00,0x50,0x00,0x20,0x02,0x01,0x00,0x01}, --Fade to Black
    }  
  }
  Response = {
    Connected =       {0xAA,0x55,0x00,0x00,0x00,0xFE,0x00,0x00,0x00,0x00,0x00,0x00,0x02,0x00,0x00,0x00,0x02,0x00,0x06,0x61,0xBE,0x56},
    ConnectedAlt =    {0xAA,0x55,0x00,0x00,0x00,0xFE,0x00,0x00,0x00,0x00,0x00,0x00,0x02,0x00,0x00,0x00,0x02,0x00,0x2a,0x61,0xE2,0x56},
    ConnectedAlt2 =   {0xAA,0x55,0x00,0x00,0x00,0xFE,0x00,0x00,0x00,0x00,0x00,0x00,0x02,0x00,0x00,0x00,0x02,0x00,0x0e,0x62,0xC7,0x56},
    ConnectedAlt3 =   {0xAA,0x55,0x00,0x00,0x00,0xFE,0x00,0x00,0x00,0x00,0x00,0x00,0x02,0x00,0x00,0x00,0x02,0x00,0x2A,0x62,0xE3,0x56},
    ConnectedAlt4 =   {0xAA,0x55,0x00,0x14,0x00,0xFE,0x00,0x00,0x00,0x00,0x00,0x00,0x00,0x00,0x02,0x02,0x02,0x00,0x2A,0x62,0xF9,0x56},
    hdmi1Active =     {0xAA,0x55,0x00,0x00,0x00,0xFE,0x00,0x00,0x00,0x00,0x01,0x00,0x13,0x03,0x00,0x00,0x00,0x00,0x69,0x57},
    hdmi2Active =     {0xAA,0x55,0x00,0x00,0x00,0xFE,0x00,0x00,0x00,0x00,0x01,0x00,0x13,0x03,0x00,0x01,0x00,0x00,0x6A,0x57},
    DPActive =       {0xAA,0x55,0x00,0x00,0x00,0xFE,0x00,0x00,0x00,0x00,0x01,0x00,0x13,0x03,0x00,0x02,0x00,0x00,0x6B,0x57},
    SdiActive =       {0xAA,0x55,0x00,0x00,0x00,0xFE,0x00,0x00,0x00,0x00,0x01,0x00,0x13,0x03,0x00,0x03,0x00,0x00,0x6C,0x57},
    PatternsValid2 =  {0xAA,0x55,0x00,0x00,0x00,0xFE,0x00,0x00,0x00,0x00,0x01,0x00,0x04,0x00,0x00,0x13,0x00,0x00,0x6B,0x56},
    PatternsValid =   {0xAA,0x55,0x00,0x00,0xFF,0xFE,0x00,0x00,0x00,0x00,0x01,0x00,0x50,0x00,0x20,0x02,0x00,0x00,0xC5,0x57},
    PresetsChanged =  {0xAA,0x55,0x00,0x00,0x00,0xFE,0x00,0x00,0x00,0x00,0x01,0x00,0x00,0x01,0x51,0x13,0x00,0x00,0xB9,0x56},
  }
  
  function init()
    Controls["Model"].Choices = models
    Controls['Port'].String = "15200"
  
    if Controls['Host'].String ~= "" then
      if string.match(Controls['Host'].String, "(%d+%.%d+%.%d+%.%d+)") then
        print("Valid IP address found")
        host = Controls['Host'].String
        if Controls['Port'].String ~= "" then
          port = tonumber(Controls['Port'].String)
          setStatus(5, 'Connecting to NovaStar')
          socket:Connect(host, port)
        else
          print("No port set")
          setStatus(3, '\nPlease set Port number.')
        end
      else
        print("Invalid IP address")
        Timer.CallAfter(clearHost, 1)
      end
    else
      setStatus(3, ' Please set host address.')
    end
  
    if Controls["Model"].String ~= "" then
      model = Controls["Model"].String
    else 
      Controls["Model"].Color = "#e3372e"
    end
  
    if model == "VX400" or model == "VX600" or model == "VX1000"then
      for i = 4,6 do 
        Controls['Input'][i].IsDisabled = true
      end
      Controls['Input'][7].IsDisabled = true
      Controls['Input'][11].IsDisabled = true
      Controls['Input'][8].Legend = "3G SDI"
    else 
      for i = 4,6 do 
        Controls['Input'][i].IsDisabled = false
      end
      Controls['Input'][7].IsDisabled = false
      Controls['Input'][11].IsDisabled = false
      Controls['Input'][8].Legend = "12G SDI"
    end
  
    if Controls['Power'].Boolean == true then 
      sendBrightness(Controls['BrightnessDefault'].Value)
      Controls['Brightness'].Value = Controls['BrightnessDefault'].Value
    else 
      sendBrightness(0)
      Controls['Brightness'].Value = 0
    end
  
    for i = 4,13 do
      Controls['TestPatterns'][i].IsDisabled = true
    end
  end
  
  setStatus = function (value, msg) 
    -- 0 = OK
    -- 1 = Compromised
    -- 2 = Fault
    -- 3 = Not Present
    -- 4 = Missing
    -- 5 = Initializing
    -- >5 = Fault
    Controls['Status'].Value = value
    Controls['Status'].String = msg
    print("TCP Socket Status: " .. msg)
  end
  
  function clearHost()
    Controls['Host'].String = ""
    setStatus(3, ' Please set host address')
  end
  
  function DecimalToHexBytes(num)
    local bytes = {}
    for i = 0, 3 do
      local byte = math.floor(num / (256 ^ i)) % 256
      table.insert(bytes, string.format("0x%02X", byte))
    end
    return bytes
  end
  
  -- Appends srcTable into destTable starting at position startPos (1-based index) 
  function AppendHexBytesAt(destTable, srcTable, startPos)
    for i = 1, #srcTable do
      destTable[startPos + i - 1] = srcTable[i]
    end
  end
  
  function hexdecode(str)
    return str:gsub(".",
      function(byte)
        local data = " " .. string.format("%02X", string.byte(byte))
        return data
      end
    )
  end
  
  function hex_dump (str)
    local len = string.len( str )
    local dump = ""
    local hex = ""
    local asc = ""
    
    for i = 1, len do
      if 1 == i % 8 then
        dump = dump .. hex .. asc .. "\n"
        hex = string.format( "%04x: ", i - 1 )
        asc = ""
      end
      
      local ord = string.byte( str, i )
      hex = hex .. string.format( "%02x ", ord )
      if ord >= 32 and ord <= 126 then
        asc = asc .. string.char( ord )
      else
        asc = asc .. "."
      end
    end
    return dump .. hex .. string.rep( "   ", 8 - len % 8 ) .. asc
  end
  
  function computeChecksum(bytes)
    local sum = 0
    for k,v in pairs(bytes) do
      sum = sum + v
    end
    sum = sum + 0x5555
    local sum_l = sum >> 8
    local sum_h = sum & 0xFF
  
    local checksum = {}
    table.insert(checksum, sum_h)
    table.insert(checksum, sum_l)
    return checksum
  end
  
  function getCmdString(bytes)
    local cmd = ""
    for k,v in pairs(bytes) do
      cmd = cmd .. string.pack("B", v)
    end
    return cmd
  end
  
  --------- Socket functions -----------------------------------------------
  
  socket.Connected = function()
    print("TCP Connection Established to NovaStar @ " .. Controls['Host'].String)
    sendCommand(Commands.Connect)
  end
  
  socket.Reconnect = function()
    print("TCP Socket Reconnecting?")
    setStatus(5,"Attempting to reconnect")
  end
  
  socket.Data = function ()
    print("Reading " .. socket.BufferLength .. " Bytes")
    local data = socket:Read(socket.BufferLength);
    local stringData = hexdecode(data)
    print("Response: " .. stringData)
    --print(hex_dump(data))
    if data == "Test" or data == getCmdString(Response.Connected) or data == getCmdString(Response.ConnectedAlt) or data == getCmdString(Response.ConnectedAlt2) or data == getCmdString(Response.ConnectedAlt3) or data == getCmdString(Response.ConnectedAlt4
  ) then
      print("Successful Connection Response Received")
      setStatus(0, "Connected - Novastar " .. model .. " (" .. Controls['Host'].String .. ")")
    elseif data == getCmdString(Response.hdmi1Active) then 
      Controls['Input'][1].Boolean = true
      for i = 2,11 do
        Controls['Input'][i].Boolean = false
      end
    elseif data == getCmdString(Response.hdmi2Active) then 
      Controls['Input'][2].Boolean = true
      Controls['Input'][1].Boolean = false
      for i = 3,11 do
        Controls['Input'][i].Boolean = false
      end
    elseif data == "ADD RESPONSE STRING FOR HDMI 3" then 
      Controls['Input'][3].Boolean = true
      Controls['Input'][2].Boolean = false
      Controls['Input'][1].Boolean = false
      for i = 4,11 do
        Controls['Input'][i].Boolean = false
      end
    elseif data == "ADD RESPONSE STRING FOR HDMI 4" then 
      Controls['Input'][4].Boolean = true
      Controls['Input'][3].Boolean = false
      Controls['Input'][2].Boolean = false
      Controls['Input'][1].Boolean = false
      for i = 5,11 do
        Controls['Input'][i].Boolean = false
      end
    elseif data == "ADD RESPONSE STRING FOR HDMI 5" then 
      Controls['Input'][5].Boolean = true
      Controls['Input'][4].Boolean = false
      Controls['Input'][3].Boolean = false
      Controls['Input'][2].Boolean = false
      Controls['Input'][1].Boolean = false
      for i = 6,11 do
        Controls['Input'][i].Boolean = false
      end
    elseif data == "ADD RESPONSE STRING FOR HDMI 6" then 
      Controls['Input'][6].Boolean = true
      Controls['Input'][5].Boolean = false
      Controls['Input'][4].Boolean = false
      Controls['Input'][3].Boolean = false
      Controls['Input'][2].Boolean = false
      Controls['Input'][1].Boolean = false
      for i = 7,11 do
        Controls['Input'][i].Boolean = false
      end
    elseif data == getCmdString(Response.DPActive) then 
      Controls['Input'][7].Boolean = true
      for i = 1,6 do
        Controls['Input'][i].Boolean = false
      end
      for i = 8,11 do
        Controls['Input'][i].Boolean = false
      end
    elseif data == getCmdString(Response.SdiActive) then 
      Controls['Input'][8].Boolean = true
      for i = 1,7 do
        Controls['Input'][i].Boolean = false
      end
      for i = 9,11 do
        Controls['Input'][i].Boolean = false
      end
    elseif data == getCmdString(Response.PatternsValid) then
      if cPattern ~= 0 then 
        Controls['TestPatterns'][cPattern].Boolean = true
        for a = 1,13 do 
          if a ~= cPattern then 
            Controls['TestPatterns'][a].Boolean = false 
          end 
        end
      end
    elseif data == getCmdString(Response.PresetsChanged) then
      if cPreset ~= 0 then 
        Controls['PresetRecall'][cPreset].Boolean = true
        for a = 1,8 do 
          if a ~= cPreset then 
            Controls['PresetRecall'][a].Boolean = false 
          end 
        end
      end
    else
      print("Ignoring response")
    end
  end
  
  socket.Closed = function()
    print("TCP Socket Closed?")
    setStatus(2,"Connection closed by NovaStar")
    --Timer.CallAfter(reconnect, 10)
    socket:Connect(host, port)
  end
  
  socket.Error = function(sock, err)
    print("TCP Socket Error: ", err)
    setStatus(2,"Communication error with NovaStar")
    socket:Connect(host, port)
  end
  
  socket.Timeout = function(sock, err)
    print("TCP Socket Timeout" )
    setStatus(2,"Timeout in connection to NovaStar")
    socket:Connect(host, port)
  end
  
  --------------------------------------------------------------------------
  function sendCommand(cmd)
    local stringData = hexdecode(getCmdString(Commands.Preamble) .. getCmdString(cmd) .. getCmdString(computeChecksum(cmd)))
    print("Command sent: " .. stringData)
    if socket.IsConnected then 
      socket:Write(getCmdString(Commands.Preamble) .. getCmdString(cmd) .. getCmdString(computeChecksum(cmd)))
    else
      print("Cannot send command, socket disconnected")
    end 
  end
  
  function sendBrightness(value)
    local cmd = Commands.Brightness
    cmd[17] = value
    local stringData = hexdecode(getCmdString(Commands.Preamble) .. getCmdString(cmd) .. getCmdString(computeChecksum(cmd)))
    print("Command sent: " .. stringData)
    if socket.IsConnected then 
      socket:Write(getCmdString(Commands.Preamble) .. getCmdString(cmd) .. getCmdString(computeChecksum(cmd)))
    else
      print("Cannot send command, socket disconnected")
    end
  end
  
  function setLayerInput(layer, input)
    input_code = InputMap[input]
    layer_code = LayerMap[layer]
    if not input_code then 
      print("Unknown input: "..tostring(input)) 
    elseif layer < 1 or layer > 5 then 
      print("Layer must be 1-5") 
    else 
      payload = {0x00,0x3E,0xFE,0x00,0x00,0x00,0x00,0x00,0x01,0x00,0x00,0x00,0x02,0x13,0x02,0x00,layer_code,input_code}
      sendCommand(payload)
    end 
  end 
  
  function sendPreset(preset)
    sendCommand(preset)
  end
  
  function sendDeletePreset(preset)
    sendCommand(preset)
  end
  
  function sendTestPattern(pattern)
    sendCommand(pattern)
  end
  
  ---- Event Handlers ----------------------------------------------------------------------
  
  --Inputs: HDMI 1, HDMI 2, HDMI 3, HDMI 4, HDMI 5, HDMI 6, DP, SDI, USB, OPTI 1, OPTI 2
  
  for i = 1,11 do
    Controls['Input'][i].EventHandler = function()
      if Controls['Input'][i].Boolean == true then
        setLayerInput(layer, i)
      end
    end 
  end
  
  Controls['Brightness'].EventHandler = function()
    sendBrightness(Controls['Brightness'].Value)
    if Controls['Brightness'].Value > 0 then 
      Controls['Power'].Boolean = true
    else
      Controls['Power'].Boolean = false 
    end
  end
  
  for i = 1,13 do 
    Controls['TestPatterns'][i].EventHandler = function()
      if Controls['TestPatterns'][i].Boolean == true then
        cPattern = i
        sendTestPattern(Commands.TestPatterns[i])
      end
    end
  end
  
  Controls['Host'].EventHandler = function() 
    if Controls['Host'].String ~= "" then
      if string.match(Controls['Host'].String, "(%d+%.%d+%.%d+%.%d+)") then
        print("Valid IP address found")
        host = Controls['Host'].String
        if Controls['Port'].String ~= "" then
          port = tonumber(Controls['Port'].String)
          setStatus(5, 'Connecting to NovaStar')
          socket:Connect(host, port)
        else
          print("No port set")
        end
      else
        print("Invalid IP address")
        Timer.CallAfter(clearHost, 1)
      end
    else
      setStatus(3, ' Please set host address.')
    end
  end
  
  Controls['Port'].EventHandler = function() 
    if Controls['Port'].String ~= "" then
      port = tonumber(Controls['Port'].String)
      if Controls['Host'].String ~= "" then
        host = Controls['Host'].String
        setStatus(5, 'Connecting to NovaStar')
        socket:Connect(host, port)
      end
    else
      setStatus(3, ' Please set host address.')
    end
  end
  
  Controls['Power'].EventHandler = function()
    if Controls['Power'].Boolean == true then 
      sendBrightness(Controls['BrightnessDefault'].Value)
      Controls['Brightness'].Value = Controls['BrightnessDefault'].Value
    else 
      sendBrightness(0)
      Controls['Brightness'].Value = 0
    end 
  end
  
  for i = 1,8 do 
    Controls['PresetRecall'][i].EventHandler = function()
      if Controls['PresetRecall'][i].Boolean == true then
        sendPreset(Commands.Presets[i])
        cPreset = i
      end
    end
  end
  
  for i = 1,8 do 
    Controls['PresetDelete'][i].EventHandler = function()
      if Controls['PresetDelete'][i].Boolean == true then
        sendDeletePreset(Commands.DeletePresets[i])
      end
    end
  end
  
  for i = 1,5 do
    Controls['BrightnessPresets'][i].EventHandler = function()   
      if Controls['BrightnessPresets'][i].Boolean == true then
        sendBrightness(BPresets[i])
        Controls['Brightness'].Value = BPresets[i] 
        if i > 1 then
          Controls['Power'].Boolean = true
        else
          Controls['Power'].Boolean = false
        end
      end
    end
  end
  
  Controls["Model"].EventHandler = function()  
    model = Controls["Model"].String
    if model == "VX400" or model == "VX600" or model == "VX1000"then
      for i = 4,6 do 
        Controls['Input'][i].IsDisabled = true
      end
      Controls['Input'][7].IsDisabled = true
      Controls['Input'][11].IsDisabled = true
      Controls['Input'][8].Legend = "3G SDI"
    else 
      for i = 4,6 do 
        Controls['Input'][i].IsDisabled = false
      end
      Controls['Input'][7].IsDisabled = false
      Controls['Input'][11].IsDisabled = false
      Controls['Input'][8].Legend = "12G SDI"
    end
    Controls["Model"].Color = "#ffffff"
  end
  
  init()
  
end
