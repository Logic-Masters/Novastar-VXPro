      {0x00,0x00,0xFE,0x00,0x00,0x00,0x00,0x00,0x01,0x00,0x04,0x01,0x51,0x13,0x01,0x00,0x02}, --Preset 3
      {0x00,0x00,0xFE,0x00,0x00,0x00,0x00,0x00,0x01,0x00,0x04,0x01,0x51,0x13,0x01,0x00,0x03}, --Preset 4
